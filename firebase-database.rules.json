{
  "rules": {
    "removedProducts": {
      ".read": true,
      ".write": true
    },
    "productOverrides": {
      ".read": true,
      ".write": true
    },
    "orders": {
      ".read": true,
      ".write": true,
      ".indexOn": ["dateKey", "createdAt"]
    },
    "expenses": {
      ".read": true,
      ".write": true,
      ".indexOn": ["dateKey"]
    }
  }
}
